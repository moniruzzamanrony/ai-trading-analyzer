# Copy this file to .env and adjust as needed

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Binance kline settings
# IMPORTANT: train and predict MUST use the same interval. The trained
# bundle stamps this value into its metadata and the predictor refuses
# to run if it disagrees. Change here → retrain.
KLINE_INTERVAL=15m
KLINE_LIMIT=300

# Directory where trained regression model files are saved
MODELS_DIR=.

# Round-trip trading fee (entry + exit), as percent of notional.
# Used to compute the net `profitPercentage` returned to the bot.
# Binance spot: 0.2 (= 0.1% × 2) by default, 0.15 if paying fees in BNB
# (0.075% × 2). Match this to the bot's trade.fee.any / trade.fee.bnb.
TRADING_FEE_PCT=0.2

# Mail settings
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_ERROR_RECIPIENT=
