# Copy this file to .env and adjust as needed

# Comma-separated list of symbols the background worker watches
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,ADAUSDT

# How often (minutes) the worker refreshes signals
WORKER_INTERVAL_MINUTES=5

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Minimum model confidence to emit BUY/SELL (below this → HOLD)
MIN_SIGNAL_CONFIDENCE=0.40

# Telegram notifications (BUY / SELL signals only)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
