# Copy this file to .env and adjust as needed

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Binance kline settings
KLINE_INTERVAL=5m
KLINE_LIMIT=300

# Directory where trained regression model files are saved
MODELS_DIR=.

# Mail settings
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_ERROR_RECIPIENT=
